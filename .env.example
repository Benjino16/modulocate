DATABASE_URL=postgres://modulocate:modulocate@localhost:5432/modulocate
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=modulocate
S3_SECRET_KEY=modulocate
S3_BUCKET=module-pictures

# Signs student vote-session JWTs (apps/backend/src/studentAuth.ts) — dev-only value, generate a real secret per environment.
STUDENT_SESSION_SECRET=

# better-auth (staff/admin auth) — dev-only value, generate a real secret per environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://modulocate.localhost

# Bootstraps one staff account on backend startup if it doesn't exist yet
# (apps/backend/src/bootstrapAdmin.ts) — leave blank to skip, e.g. once you
# have a real signup flow and don't want a fixed dev account anymore.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Local dev: Mailpit (see infra/compose.yaml), no auth required, view mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Modulocate <no-reply@modulocate.local>"

VOTE_APP_URL=http://modulocate.localhost/voting
