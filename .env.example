DATABASE_URL=postgres://modulocate:modulocate@localhost:5432/modulocate
REDIS_URL=redis://localhost:6379

# Consumed directly by infra/compose.prod.yaml to configure the postgres
# container and to build DATABASE_URL for backend/worker/migrate — keep
# these in sync with the credentials in DATABASE_URL above. DO NOT reuse
# these dev placeholders in staging/prod, pick a real password there.
POSTGRES_USER=modulocate
POSTGRES_PASSWORD=modulocate
POSTGRES_DB=modulocate

# Consumed only by infra/compose.prod.yaml's traefik service for the
# websecure (:443) entrypoint's Let's Encrypt cert — DOMAIN must already
# point (A/AAAA) at this host, ACME_EMAIL is where Let's Encrypt sends
# expiry/problem notices. Not read anywhere in dev. If you change DOMAIN,
# also update BETTER_AUTH_URL/VOTE_APP_URL below to https://<DOMAIN>/... in
# your real prod .env — they stay http://modulocate.localhost here on
# purpose, as dev-only placeholders like the secrets above.
DOMAIN=modulocate.example.com
ACME_EMAIL=admin@example.com

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=modulocate
S3_SECRET_KEY=modulocate
S3_BUCKET=module-pictures

# Signs student vote-session JWTs (apps/backend/src/studentAuth.ts). Fixed
# dev-only placeholder so a fresh `cp .env.example .env` works out of the box
# — deliberately not a random-looking string, so it can't be mistaken for an
# already-generated secret. DO NOT reuse in staging/prod, regenerate there
# with `openssl rand -hex 32`.
STUDENT_SESSION_SECRET=dev-only-insecure-student-session-secret-change-me

# better-auth (staff/admin auth). Fixed dev-only placeholder, same reasoning
# as STUDENT_SESSION_SECRET above — DO NOT reuse in staging/prod, regenerate
# there with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=dev-only-insecure-better-auth-secret-change-me
BETTER_AUTH_URL=http://modulocate.localhost

# Bootstraps one staff account on backend startup if it doesn't exist yet
# (apps/backend/src/bootstrapAdmin.ts) — leave blank to skip, e.g. once you
# have a real signup flow and don't want a fixed dev account anymore.
ADMIN_EMAIL=admin@modulocate.local
ADMIN_PASSWORD=modulocate-dev
ADMIN_NAME=admin

# Local dev: Mailpit (see infra/compose.dev.yaml), no auth required, view mail at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Modulocate <no-reply@modulocate.local>"

VOTE_APP_URL=http://modulocate.localhost/voting
