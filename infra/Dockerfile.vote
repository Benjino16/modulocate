# Production image for @modulocate/vote-web — same shape as
# infra/Dockerfile.portal, see the comment there.
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS base
RUN corepack enable
WORKDIR /app

# ---- prune: isolate just the workspace subset vote-web needs ----
FROM base AS pruner
RUN npm install -g turbo@2
COPY . .
RUN turbo prune @modulocate/vote-web --docker

# ---- install (cached unless deps change) + build ----
FROM base AS build
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm --filter @modulocate/vote-web build

# ---- runtime: static files behind nginx, already non-root by default ----
FROM nginxinc/nginx-unprivileged:alpine@sha256:c3fed6436b61d2bf2201ec032c35c000871f7ed062dea5d586bc6bf4d0fdd140 AS runtime
COPY infra/nginx.vote.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/vote/dist /usr/share/nginx/html/voting
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
